{# One BFD profile per BFD-enabled routing domain, carrying that domain's
   authored timers; each domain's IGP interfaces reference their own. #}
bfd
{% for profile in bfd_profiles %}
 profile {{ profile.name }}
  detect-multiplier {{ profile.detect_multiplier }}
  receive-interval {{ profile.rx_interval }}
  transmit-interval {{ profile.tx_interval }}
 exit
{% endfor %}
exit
