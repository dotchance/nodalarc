{# Timer and BFD values are resolver-owned per-domain facts supplied by the
   producer (routing.domains[].timers); the template carries no fallbacks.
   OSPFv2 routes IPv4; IPv6 nodes also run OSPFv3 (the ospf6d fragment). #}
router ospf
{% if "ipv4" in redistribute_static %}
 redistribute static
{% endif %}
 ospf router-id {{ ipv4_loopback }}
{# Traffic engineering and segment routing both flood opaque LSAs, which
   ospfd originates only with the opaque capability enabled. #}
{% if te_enabled or sr_enabled %}
 capability opaque
{% endif %}
{% if te_enabled %}
 mpls-te on
 mpls-te router-address {{ ipv4_loopback }}
{% endif %}
{% if sr_enabled %}
 segment-routing on
 segment-routing global-block {{ srgb_start }} {{ srgb_end }} local-block {{ srlb_start }} {{ srlb_end }}
 segment-routing prefix {{ ipv4_loopback }}/32 index {{ node_sid_index }}
{% endif %}
 timers throttle spf {{ ospf_spf_delay }} {{ ospf_spf_initial_hold }} {{ ospf_spf_max_hold }}
{% if "ipv4" in default_route_families %}
 default-information originate always metric {{ default_route_metric }}
{% endif %}
exit

interface lo
 ip ospf area {{ area_id }}
 ip ospf passive
exit

{% for iface in wan_interfaces if not iface.static_only %}
interface {{ iface.name }}
 ip ospf area {{ iface.ospf_area }}
 ip ospf network point-to-point
 ip ospf cost {{ iface.metric }}
 ip ospf hello-interval {{ ospf_hello_interval }}
 ip ospf dead-interval {{ ospf_dead_interval }}
{% if iface.bfd %}
 ip ospf bfd
 ip ospf bfd profile NODAL
{% endif %}
exit
{% endfor %}

{% for segment in segment_interfaces if "ipv4" in segment.igp_families %}
interface {{ segment.name }}
 ip ospf area {{ area_id }}
{% if not segment.igp_active %}
 ip ospf passive
{% endif %}
{% if segment.bfd %}
 ip ospf bfd
 ip ospf bfd profile NODAL
{% endif %}
exit
{% endfor %}
