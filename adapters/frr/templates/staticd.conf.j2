{# A node that declares `default` in a family holds a default route of its
   own in that family. Each IS-IS or OSPF instance the node runs advertises
   it; a node that runs neither holds the route and advertises nothing. The
   route points at Null0: a packet that matches nothing more specific is
   dropped at the node that declares the default. #}
{% if "ipv4" in default_route_families %}
ip route 0.0.0.0/0 Null0
{% endif %}
{% if "ipv6" in default_route_families %}
ipv6 route ::/0 Null0
{% endif %}

{# Static routes to a static_ip boundary peer's loopbacks over the
   point-to-point boundary link, in each family both ends carry. #}
{% for link in static_links %}
ip route {{ link.peer_loopback_ipv4 }}/32 {{ link.name }}
{% if link.peer_loopback_ipv6 %}
ipv6 route {{ link.peer_loopback_ipv6 }}/128 {{ link.name }}
{% endif %}
{% endfor %}

{# Routing-boundary exports (adapter: static_ip): materialized intent from
   routing.boundaries[].export; next hop recurses over the peer-loopback
   route above. #}
{% for route in boundary_static_routes %}
{% if route.family == "ipv6" %}
ipv6 route {{ route.prefix }} {{ route.via }}
{% else %}
ip route {{ route.prefix }} {{ route.via }}
{% endif %}
{% endfor %}
